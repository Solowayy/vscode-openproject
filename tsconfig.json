{
  "compilerOptions": {
    "moduleResolution": "node",
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "out",
    "lib": ["ES2020"],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
        "vscode": ["./src/test/mocks/vscode.ts"]
    },
    "types": [
			"node",
			"vscode",
      "mocha"
		]
  },
  "exclude": ["node_modules", ".vscode-test"]
}